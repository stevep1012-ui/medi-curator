{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "google.maps"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    // 출하되는 개인정보처리방침이 사업자 정보를 config/release-profile.json 에서
    // 직접 읽게 하려면 필요하다(P0-007). 사본을 두면 gate:release-readiness 가
    // 검사하는 파일과 화면에 실제로 뜨는 값이 갈라진다.
    "resolveJsonModule": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "config/release-profile.json"]
}
